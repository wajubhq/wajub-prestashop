{
    "name": "wajub/prestashop-wajub",
    "description": "Wajub payments for PrestaShop: Mobile Money, cards and other payment methods.",
    "type": "prestashop-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Wajub",
            "homepage": "https://wajub.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "prestashop/php-dev-tools": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Wajub\\PrestaShop\\": "src/"
        }
    },
    "config": {
        "prepend-autoloader": false,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "platform-check": false
    },
    "scripts": {
        "check": "bin/check.sh",
        "build": "bin/build-zip.sh"
    }
}
